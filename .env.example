# ProcessIQ Environment Variable Template
# Note: Version 1.0 executes 100% in the client browser with zero database.
# No secrets or database credentials are required for standard deployment.

# Application Base URL (Set in Vercel project environment if custom domain used)
NEXT_PUBLIC_APP_URL=https://processiq.vercel.app

# Analytics (Optional, leave blank to preserve zero-telemetry default)
NEXT_PUBLIC_ANALYTICS_ID=
